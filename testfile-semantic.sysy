/* =====================================================================
 * 语义分析（第三阶段）测试程序 —— 预期零错误
 * ---------------------------------------------------------------------
 * 覆盖点：
 *   [1] 13 种符号类型名：Int / Char / IntArray / CharArray
 *       ConstInt / ConstChar / ConstIntArray / ConstCharArray
 *       StaticInt / StaticArray / StaticChar / StaticCharArray
 *       IntFunc / CharFunc / VoidFunc
 *   [2] 作用域编号：全局 = 1，函数体最外层与形参共用一个号，
 *       嵌套块才开新号
 *   [3] main 不进符号表；7 个运行时库函数不进符号表但能调用
 *   [4] 常量折叠：数组长度、const 初值、case 标签、下标上限
 *   [5] 数组：声明的长度、形参 int a[]、数组实参传给数组形参
 *   [6] char 与 int 严格区分（这里都写得合法）
 *   [7] switch / while / break / continue 的合法性
 *   [8] 字符串初始化 char 数组
 * ===================================================================== */

const int year = 2026, month = 10;
const char grade = 'A';
const int table[3] = {1, 2, 3};
const char vowels[3] = {'a', 'e', 'i'};

int counter = 0;
char letter = 'z';
int scores[4] = {90, 80, 70, 60};
char name[8] = "sysy";

int getDay(int y, int m) {
    int day = y + m;
    {
        int day = 1;
        day = day + 1;
    }
    return day;
}

char pick(char a, char b) {
    if (a == b) {
        return a;
    } else {
        return b;
    }
}

int total(int values[], int n) {
    static int callCount = 0;
    static char mode = 'a';
    static char tags[3] = {'x', 'y', 'z'};
    int sum = 0;
    int i = 0;
    callCount = callCount + 1;
    while (i < n) {
        if (values[i] == 0) {
            i = i + 1;
            continue;
        }
        sum = sum + values[i];
        if (sum > 100) {
            break;
        }
        i = i + 1;
    }
    return sum;
}

void report(char text[], int value) {
    put_string(text);
    put_int(value);
    return;
}

int main() {
    int local = get_int();
    char ch = get_char();
    int day = getDay(local, month);
    char flag = pick(ch, grade);
    int sum = total(scores, 4);

    switch (flag) {
        case 'a':
            day = day + 1;
            break;
        case 'z':
            day = day + 2;
            break;
        default:
            day = day + 3;
    }

    report(name, sum);
    put_char(letter);
    printf("%d %c\n", day, flag);
    return 0;
}
